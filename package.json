{
  "name": "hcacher",
  "version": "0.3.1",
  "private": false,
  "description": "In-memory cache manager with optional TTL, FIFO or strict-LRU eviction, and event bus",
  "keywords": [
    "cache",
    "deduplication",
    "events",
    "in-memory",
    "lru",
    "ttl",
    "typescript"
  ],
  "homepage": "https://github.com/dirold2/hcacher#readme",
  "bugs": {
    "url": "https://github.com/dirold2/hcacher/issues"
  },
  "license": "MIT",
  "author": "dirold2",
  "repository": {
    "type": "git",
    "url": "https://github.com/dirold2/hcacher.git"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "!dist/**/*.map"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsc && esbuild 'dist/**/*.js' --outdir=dist --allow-overwrite --minify --sourcemap && esbuild dist/index.js --outfile=dist/index.cjs --format=cjs --bundle --minify --sourcemap && d-build",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "d-dist",
    "deploy": "npm run build && npm run dist",
    "pub": "d-publish",
    "prepublish": "npm run build",
    "lint": "oxlint src tests",
    "lint:fix": "oxlint src tests --fix",
    "format": "oxlint --fix . && oxfmt ."
  },
  "devDependencies": {
    "@dirold2/dev-tools": "^1.1.3",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^4.1.12",
    "chalk": "^6.0.1",
    "dotenv-cli": "^11.1.0",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "hemmiter": "^0.1.1"
  },
  "engines": {
    "node": ">=18"
  }
}
